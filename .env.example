OPENAI_API_KEY=sk-your-openai-key
# Works with a SerpAPI key (serpapi.com, 64 chars) or a Serper.dev key (serper.dev, 40 chars).
SERPAPI_API_KEY=your-search-key
# Optional tuning
SEARCH_PROVIDER=auto   # auto | serpapi | serper
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_SIMILARITY_THRESHOLD=0.88
HISTORY_TURNS=3
MAX_COMPLETION_TOKENS=600
